{
  "name": "@bahari/react",
  "version": "0.4.0",
  "description": "Browser components and hooks for Bahari Accounts sign-in. Talks only to your own backend (@bahari/node or @bahari/nextjs); holds no secrets and no tokens.",
  "license": "MIT",
  "author": "Bahari",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bahari",
    "sso",
    "react",
    "hooks",
    "authentication"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
